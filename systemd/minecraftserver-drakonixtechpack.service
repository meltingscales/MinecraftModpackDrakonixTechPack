[Unit]
Description=Drakonix Tech Pack modded Minecraft server (NeoForge 1.21.1)
After=network.target

[Service]
User=minecraft
Group=minecraft
WorkingDirectory=/srv/minecraft/drakonixtechpack
# Inherited by the java child process run.sh execs into; backup.sh scans
# /proc/*/environ for this to tell "server down" from "RCON misconfigured
# while the server is actually up".
Environment=MC_SERVER_MARKER=drakonixtechpack
# NeoForge 1.21.1 requires Java 21. run.sh execs bare `java`, so pin PATH here
# rather than editing run.sh - it's regenerated on every `just packwiz-export`
# from the pack. Without this, the host's default java (26) crashes Mixin with
# "Unsupported class file major version <N>" mid-boot.
Environment=PATH=/usr/lib/jvm/java-21-openjdk/bin:/usr/bin:/bin
ExecStart=/srv/minecraft/drakonixtechpack/run.sh nogui
Restart=on-failure
RestartSec=10
# NeoForge server saves the world and exits cleanly on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
